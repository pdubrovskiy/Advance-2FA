#!/bin/sh

echo "Running pre-commit checks..."

# Change to the server directory
cd server || {
    echo "❌ Failed to change to server directory"
    exit 1
}

# Get staged files (only in server directory)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep "^server/.*\.ts$")

if [ -z "$STAGED_FILES" ]; then
    echo "No TypeScript files staged in server directory. Skipping checks."
    exit 0
fi

# Run ESLint
echo "Running ESLint..."
yarn lint || {
    echo "❌ ESLint check failed. Please fix the errors and try again."
    exit 1
}

# Run Prettier
echo "Running Prettier..."
yarn format || {
    echo "❌ Prettier check failed. Please fix the formatting and try again."
    exit 1
}

echo "✅ Pre-commit checks passed!"
exit 0 